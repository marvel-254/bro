{
  "expo": {
    "name": "BRO",
    "slug": "bro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bro",
      "infoPlist": {
        "NSCameraUsageDescription": "Video calls need the camera so the other person can see you.",
        "NSMicrophoneUsageDescription": "Voice and video calls need the microphone so the other person can hear you."
      }
    },
    "android": {
      "package": "app.bro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090A0F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bro",
              "host": "*"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ],
      "permissions": [
        "INTERNET",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "usesCleartextTraffic": false,
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "bro",
    "extra": {
      "eas": {
        "projectId": "bro-app"
      }
    }
  }
}
