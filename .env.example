# BRO — Environment Variables
# Copy this file to .env (or .env.local) and fill in real values.
# See .github/workflows/secrets-setup.md for how to configure these in CI.
# ---------------------------------------------------------------------------
# IMPORTANT: Variables prefixed with EXPO_PUBLIC_ are embedded into the
# client bundle at build time (Expo convention). They are NOT secret at
# runtime once the app is built. Never store server-side secrets here.
# Commit this file. Do NOT commit the .env file you create from it.

# Clerk publishable key for authentication.
# The @clerk/clerk-expo SDK reads this automatically (ClerkProvider in
# app/_layout.tsx relies on it). Obtain it from the Clerk dashboard:
#   https://dashboard.clerk.com -> select the BRO application ->
#   "API keys" -> "Publishable key" (starts with "pk_").
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Base URL of the BRO backend API.
# Read in src/constants/index.tsx as EXPO_PUBLIC_API_URL / API_BASE_URL.
# If empty, the app falls back to "https://api.bro.app".
# Set this to a staging or local URL for development (e.g. http://10.0.2.2:3000).
EXPO_PUBLIC_API_URL=
