# BRO — Environment Variables
# Copy this file to .env (or .env.local) and fill in real values.
# See .github/workflows/secrets-setup.md for how to configure these in CI.
# ---------------------------------------------------------------------------
# IMPORTANT: Variables prefixed with EXPO_PUBLIC_ are embedded into the
# client bundle at build time (Expo convention). They are NOT secret at
# runtime once the app is built. Never store server-side secrets here.
# Commit this file. Do NOT commit the .env file you create from it.

# Supabase — backend for authentication, conversations and messages.
# The anon key is a public key: it only permits what row level security allows.
# Obtain both from the Supabase dashboard:
#   https://supabase.com/dashboard -> select the BRO project -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 — public read base for meme files.
# The catalogue (titles, tags, dimensions) lives in Postgres; only the images
# live in R2, so the app needs only this base URL, never a credential.
# From: wrangler r2 bucket dev-url enable bro-memes
# This is the r2.dev dev subdomain, which is rate limited and not intended for
# production. Move to a custom domain (wrangler r2 bucket domain) before
# launch; nothing in the client changes, only this value.
# Cloudflare Worker that accepts meme uploads. The client never holds an R2
# credential; it posts the bytes here and the Worker verifies the caller,
# enforces the 30/day quota, and picks the object key.
EXPO_PUBLIC_MEME_UPLOAD_URL=https://bro-meme-upload.twistedoliver211fs.workers.dev

EXPO_PUBLIC_R2_MEDIA_URL=

# Base URL of the BRO backend API.
# Read in src/constants/index.tsx as EXPO_PUBLIC_API_URL / API_BASE_URL.
# If empty, the app falls back to "https://api.bro.app".
# Set this to a staging or local URL for development (e.g. http://10.0.2.2:3000).
EXPO_PUBLIC_API_URL=

# Supabase — the real backend for conversations, messages, spaces and realtime.
